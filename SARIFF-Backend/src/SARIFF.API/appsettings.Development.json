{
  "Environment": "Development",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sariff_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "SecretKey": "DevSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "SARIFF",
    "Audience": "SARIFF-Users",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5000"
    ]
  },
  "App": {
    "WebsiteUrl": "https://app.sariff.com"
  },
  "AfricasTalking": {
    "Username": "sandbox",
    "ApiKey": "",
    "SenderId": "SARIFF",
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SARIFF": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sariff-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Features": {
    "ClientIdentity": true
  }
}