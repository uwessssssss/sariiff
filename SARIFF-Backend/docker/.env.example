# SARIFF Docker Environment Variables

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sariff_db

# JWT (the API reads JWT_SECRET_KEY)
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=
JWT_ISSUER=SARIFF
JWT_AUDIENCE=SARIFF-Users

# Twilio (optional - for WhatsApp)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Database for the API (Render: use the Internal Database URL converted to this form)
ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=sariff_db;Username=...;Password=...

# Africa's Talking SMS (OTP). Rotate the old key that was committed before Oct 2026.
AfricasTalking__Username=
AfricasTalking__ApiKey=
AfricasTalking__Enabled=true

# Only to create the super admin on a brand-new production database; remove all
# four afterwards. Production seeding creates ONLY the super admin (no test data).
SEED_DATA=false
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=

# Production CORS: the web app's address(es), one per index
Cors__AllowedOrigins__0=
# Link sent in credential SMS/WhatsApp messages
App__WebsiteUrl=
